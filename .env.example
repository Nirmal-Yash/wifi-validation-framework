# Runtime configuration — never store operational secrets in tracked files.
WIFI_ROUTER1_PASSWORD=
WIFI_ROUTER2_PASSWORD=
WIFI_AP_HOST_PASSWORD=
WIFI_CLIENT_VM_PASSWORD=
WIFI_MONITOR_VM_PASSWORD=
WIFI_TEST_PSK=

FIRMWARE_VERSION=v1.0
NETREGRESS_DATABASE_PATH=results/test_results.db
# TEST_DB_PATH remains supported as a compatibility alias; do not set it to a different path.

NETREGRESS_AUTH_REQUIRED=1
NETREGRESS_SESSION_SECRET=
NETREGRESS_AUTH_USERS_JSON=
NETREGRESS_CONFIG_JSON={}
NETREGRESS_FIRMWARE_ROOT=firmware
NETREGRESS_REQUIRE_FIRMWARE_SIGNATURE=0

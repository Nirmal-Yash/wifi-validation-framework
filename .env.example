# Environment Variables for WiFi Validation Framework
# Copy this file to .env and customize values for your deployment.

# Device Passwords (overrides defaults in configs/devices.yaml)
WIFI_ROUTER1_PASSWORD=admin
WIFI_ROUTER2_PASSWORD=admin
WIFI_AP_PASSWORD=admin
WIFI_CLIENT_PASSWORD=admin
WIFI_MONITOR_PASSWORD=admin

# Test Execution Parameters
FIRMWARE_VERSION=v1.0
TEST_DB_PATH=results/test_results.db
